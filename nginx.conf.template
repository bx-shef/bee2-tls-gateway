# Crypto gateway (#460) — plain HTTP in, STB 34.101.65 (BTLS) out.
#
# Rendered by entrypoint.sh through `envsubst` with an EXPLICIT variable allowlist, so
# nginx's own `$status`/`$upstream_status`/... survive the substitution untouched.
#
# ⚠ Everything here is a CLIENT-side TLS config (`proxy_ssl_*`). The gateway terminates
# NO TLS of its own: it must never be published to the host, only attached to an
# internal compose network. See README.md § "Граница доверия".

worker_processes 1;
daemon off;
error_log stderr ${GW_ERROR_LOG_LEVEL};
pid /tmp/crypto-gw.pid;

events {
    worker_connections 256;
}

http {
    default_type application/octet-stream;

    # NO $request / $uri / $args ANYWHERE IN THE LOG LINE. The resource path carries the
    # account number (/open-banking/v1.0/accounts/<IBAN>/statements) — a financial
    # identifier we are not entitled to scatter into log aggregation. $gw_route names
    # which allowlisted branch handled the call, which is all the routing detail an
    # operator actually needs.
    log_format gw '$time_iso8601 route=$gw_route method=$request_method '
                  'status=$status upstream=$upstream_status bytes=$body_bytes_sent '
                  'rt=$request_time urt=$upstream_response_time';
    access_log /dev/stdout gw;

    # A deliberately constant rate-limit key — see the zone below. `map` is the only way
    # nginx lets you hand a literal to `limit_req_zone`, which insists on a variable.
    map $host $gw_limit_key {
        default gw;
    }

    # Route label for the log line, derived from the URI rather than `set` inside each
    # location. `limit_except`'s deny runs in an implicit child context, so a `set` in the
    # parent location never executes for a rejected method — and the 403s, which are the
    # log lines an operator most wants to identify, would come out with an empty route.
    # ⚠ Метки маршрутов приезжают из того же GW_ALLOW, что и сами маршруты (#7), — иначе
    # при смене путей лог показывал бы `route=none` на разрешённом запросе, и оператор
    # читал бы неправду. Метка строится из НАСТРОЕННОГО пути, не из пути запроса: в
    # запросе ездит номер счёта.
    map $uri $gw_route {
        default    none;
        /healthz   health;
        include /tmp/crypto-gw.routes-map.conf;
    }

    # Sized for a background poll, not for a crowd. All traffic arrives from our own
    # backend/worker containers, so this exists to bound damage (and to protect the
    # bank's request budget), not to shape real load.
    # ⚠ Keyed on a CONSTANT, not on $binary_remote_addr, so the whole gateway shares ONE
    # bucket. Per-IP would multiply the cap by the number of callers — and the deploy
    # scales the worker (`--scale worker=N`), each replica getting its own address on
    # cryptonet, so a "10 r/s" cap would silently become 10·N r/s toward the bank, which
    # is the opposite of what this zone is for.
    limit_req_zone $gw_limit_key zone=gw:1m rate=${GW_RATE}r/s;
    limit_req_status 429;

    upstream bank {
        server ${GW_UPSTREAM_HOST}:${GW_UPSTREAM_PORT};
        # THE reason nginx was chosen over a TCP tunnel: a BIGN handshake is expensive,
        # and one poll of one account is ~10 HTTP requests. Keeping the upstream session
        # alive collapses those onto a single TLS handshake.
        keepalive ${GW_KEEPALIVE};
        keepalive_timeout 60s;
        keepalive_requests 100;
    }

    server {
        listen ${GW_LISTEN};
        server_name _;

        # Consent/statement request bodies are small JSON documents.
        client_max_body_size 64k;
        client_body_buffer_size 64k;

        # ---- upstream TLS: this is the whole point of the image -------------------
        proxy_ssl_protocols TLSv1.2;
        # DHE FIRST, DHT SECOND, deliberately. Both are STB 34.101.65, but DHT-BIGN is
        # key TRANSPORT — the premaster is encrypted to the server's long-term key, so a
        # future compromise of that key decrypts recorded sessions. DHE-BIGN is
        # ephemeral and has forward secrecy.
        # ⚠ THIS IS A PREFERENCE, NOT A GUARANTEE. It is what we OFFER and in what order;
        # whether the bank honours client order or enforces its own (server preference)
        # is unknown — and the one live probe we have, run without an explicit list,
        # came back with DHT. So the live run must log the cipher actually negotiated
        # (#461) instead of assuming this line settled it.
        proxy_ssl_ciphers DHE-BIGN-WITH-BELT-CTR-MAC-HBELT:DHE-BIGN-WITH-BELT-DWP-HBELT:DHT-BIGN-WITH-BELT-CTR-MAC-HBELT:DHT-BIGN-WITH-BELT-DWP-HBELT;

        # Chain AND hostname in one directive. Without `proxy_ssl_verify on` the channel
        # is encrypted but the peer is unproven, which is not what a payments path needs.
        proxy_ssl_verify on;
        proxy_ssl_verify_depth 3;
        proxy_ssl_trusted_certificate ${GW_CA_BUNDLE};
        proxy_ssl_server_name on;
        proxy_ssl_name ${GW_UPSTREAM_HOST};
        proxy_ssl_session_reuse on;

        # ---- request shaping ------------------------------------------------------
        proxy_http_version 1.1;
        # The Host the BANK must see. A TCP tunnel cannot do this — it would forward
        # `Host: crypto-gw:1080` and the bank's API gateway would reject the call.
        # ⚠ WITH THE PORT. Every Priorbank endpoint is on a non-standard port (9344/9345/
        # 9544), so a direct call from Node sends `Host: apibel.priorbank.by:9345` — that
        # is the header their API gateway has always received from us. Dropping the port
        # here would silently change it, and if they virtual-host on host:port the result
        # is 100% failures showing up as a bare `status=502` with no explanation.
        proxy_set_header Host ${GW_UPSTREAM_HOST}:${GW_UPSTREAM_PORT};
        # Empty Connection is required for upstream keepalive to engage at all.
        proxy_set_header Connection "";
        # Our internal topology is not the bank's business, and these headers would
        # leak container names / private addresses into a third party's logs.
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Forwarded-Proto "";
        proxy_set_header X-Real-IP "";

        proxy_connect_timeout ${GW_CONNECT_TIMEOUT};
        proxy_send_timeout ${GW_READ_TIMEOUT};
        proxy_read_timeout ${GW_READ_TIMEOUT};

        proxy_buffering on;
        proxy_buffers 16 32k;
        proxy_busy_buffers_size 64k;

        # ---- routes ---------------------------------------------------------------
        # Container-local liveness. Must not touch DNS or the bank: a healthcheck that
        # depends on the upstream turns a bank outage into a restart loop.
        location = /healthz {
            limit_except GET { deny all; }
            access_log off;
            # `default_type`, not `add_header`: add_header APPENDS, so with the
            # application/octet-stream default above the response would carry TWO
            # Content-Type headers.
            default_type text/plain;
            return 200 "ok\n";
        }

        # Разрешённые маршруты приезжают ОТСЮДА, а не выписаны здесь: их генерирует
        # entrypoint.sh из GW_ALLOW (#7). Пути — это API конкретного банка, а образ про
        # банк не знает ничего: хост апстрима давно переменная, теперь и пути тоже.
        #
        # ⚠ Файл содержит ТОЛЬКО РАЗРЕШЕНИЯ. Отказ по умолчанию ниже и `/healthz` выше
        # живут здесь структурно, и никакая конфигурация их не отменяет: пустой или
        # незаполненный список даёт «не разрешено ничего», а не «разрешено всё». Это
        # свойство формы, а не проверка, которую можно забыть прогнать.
        include /tmp/crypto-gw.routes.conf;

        # Everything else is refused HERE rather than relayed. An open relay to a bank
        # is worth more to an attacker than anything else on this network.
        # LOGGED on purpose: this is the only unauthenticated entrance to the system, so
        # somebody probing it is precisely the signal worth having. The `gw` format
        # carries no path, so logging these costs no privacy.
        location / {
            return 404;
        }
    }
}
