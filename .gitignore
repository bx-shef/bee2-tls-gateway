# Скомпилированный питон: артефакт запуска, а не исходник. Один такой файл уже уехал в
# репозиторий вместе с чужим PR — он появляется сам от любого `python3 -m py_compile`
# или импорта, и заметить его в дифе трудно именно потому, что он бинарный.
__pycache__/
*.pyc

# Инструменты проекта умеют выпускать приватные ключи (scripts/make-btls-fixture.sh).
# Класть их в дерево незачем, но человек ослушается инструкции быстрее, чем правило
# устареет: в публичном репозитории утёкший ключ скомпрометирован с момента пуша.
*.key
btls-pki/
